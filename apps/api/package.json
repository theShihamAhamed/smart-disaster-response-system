{
  "name": "@disaster/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify-seed": "tsx prisma/verify-seed.ts"
  },
  "dependencies": {
    "@disaster/domain": "0.1.0",
    "@disaster/shared-types": "0.1.0",
    "@disaster/shared-validation": "0.1.0",
    "@prisma/client": "^6.16.2",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
