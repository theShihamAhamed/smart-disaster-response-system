# Copy this file to .env and replace placeholders there. Never commit .env.
# Pooled Neon connection used by the API and other normal application traffic.
DATABASE_URL="postgresql://USER:PASSWORD@NEON_POOLED_HOST/DATABASE?sslmode=require&schema=public"
# Direct/unpooled connection used by Prisma CLI migration commands.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@NEON_DIRECT_HOST/DATABASE?sslmode=require&schema=public"

# API and client application configuration.
PORT=4000
# Development/demo only. Set to true explicitly to allow X-Dev-User-Id authentication.
DEV_AUTH_ENABLED=false
WEB_API_BASE_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
